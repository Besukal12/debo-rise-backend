generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum Role {
  STUDENT
  MENTOR
  SUPPORTER
  CIRCLE_LEAD
  GUARDIAN
  ADMIN
}

enum AgeGroup {
  MINOR
  ADULT
}

enum EducationLevel {
  HIGH_SCHOOL_STUDENT
  HIGH_SCHOOL_GRADUATE
  UNIVERSITY_STUDENT
  UNIVERSITY_GRADUATE
  OTHER
}

enum WorkStatus {
  STUDENT_ONLY
  UNEMPLOYED_SEEKING_WORK
  FREELANCER
  EMPLOYED
  OTHER
}

enum RequestStatus {
  OPEN
  HELPING
  SOLVED
  CLOSED
}

enum LessonStatus {
  LOCKED
  UPCOMING
  IN_PROGRESS
  DONE
}

enum CertificationStatus {
  PENDING
  APPROVED
  NEEDS_CHANGES
  DEFERRED
}

enum LanguagePref {
  EN
  AM
}

enum MeetingType {
  TYPE_A
  TYPE_B
}

// 1. IDENTITY & USER MANAGEMENT

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  fullName     String
  role         Role   @default(STUDENT)

  // Demographics & Background
  age            Int
  ageGroup       AgeGroup
  educationLevel EducationLevel @default(HIGH_SCHOOL_STUDENT)
  workStatus     WorkStatus     @default(UNEMPLOYED_SEEKING_WORK)

  // Cloudinary Image Asset URL
  avatarUrl String?

  schoolOrOrg    String?
  location       String?      @default("Addis Ababa")
  language       LanguagePref @default(EN)
  dailyReminders Boolean      @default(true)
  helpNotify     Boolean      @default(true)
  isPrivate      Boolean      @default(true)

  // Gamification & Progression
  growthLevel   Int    @default(1)
  stageName     String @default("Active Sprout")
  stageProgress Int    @default(0)
  deboSparks    Int    @default(0)
  helpsGiven    Int    @default(0)

  // Guardian & Youth Protection
  guardianName  String?
  guardianEmail String?
  guardianPhone String?
  parentConsent Boolean @default(false)

  // Soft Delete & Auditability
  deletedAt DateTime?

  // Relations
  trackId String?
  track   Track?  @relation(fields: [trackId], references: [id])

  refreshTokens    RefreshToken[]
  deviceTokens     DeviceToken[]
  helpRequests     HelpRequest[]
  replies          HelpReply[]
  assignedTickets  HelpRequest[]        @relation("MentorAssignments")
  progresses       UserLessonProgress[]
  projects         Project[]
  submissions      Submission[]
  certifications   Certification[]      @relation("MentorCertifications")
  attendanceLogs   AttendanceRecord[]   @relation("StudentAttendance")
  markedAttendance AttendanceRecord[]   @relation("SupporterAttendance")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trackId])
  @@index([role])
  @@index([deletedAt])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pushToken String   @unique
  platform  String
  lastSeen  DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// 2. CURRICULUM, TRACKS & PROGRESS

model Track {
  id          String         @id @default(uuid())
  slug        String         @unique
  title       String
  description String
  modules     Module[]
  users       User[]
  meetings    TrackMeeting[]
}

model Module {
  id         String   @id @default(uuid())
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  weekNumber Int
  title      String
  lessons    Lesson[]

  @@index([trackId])
}

model Lesson {
  id           String  @id @default(uuid())
  moduleId     String
  module       Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessonNumber Int
  title        String
  durationMin  Int
  isMilestone  Boolean @default(false)

  readMarkdown  String  @db.Text
  videoUrl      String?
  videoDuration String?
  starterCode   String? @db.Text
  checklist     Json

  progresses   UserLessonProgress[]
  submissions  Submission[]
  helpRequests HelpRequest[]

  @@index([moduleId])
}

model UserLessonProgress {
  id          String       @id @default(uuid())
  userId      String
  lessonId    String
  status      LessonStatus @default(UPCOMING)
  checkedList Json
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  updatedAt   DateTime     @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

// 3. COMMUNITY HELP TICKETS (#CallADebo)

model HelpRequest {
  id           String  @id @default(uuid())
  ticketNumber Int     @default(autoincrement())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String?
  lesson       Lesson? @relation(fields: [lessonId], references: [id])

  title         String
  whatDidYouTry String        @db.Text
  stuckMinutes  Int           @default(20)
  status        RequestStatus @default(OPEN)

  // Cloudinary Screenshot Preview URL
  previewImageUrl String?

  assignedMentorId String?
  assignedMentor   User?   @relation("MentorAssignments", fields: [assignedMentorId], references: [id])

  idempotencyKey String? @unique

  replies   HelpReply[]
  deletedAt DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
  @@index([userId])
  @@index([idempotencyKey])
}

model HelpReply {
  id        String      @id @default(uuid())
  requestId String
  request   HelpRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  content     String  @db.Text
  codeSnippet String? @db.Text
  isSolution  Boolean @default(false)
  likesCount  Int     @default(0)

  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([requestId])
  @@index([userId])
}

// 4. SUBMISSIONS & MENTOR CERTIFICATIONS

model Submission {
  id       String @id @default(uuid())
  userId   String
  lessonId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson   Lesson @relation(fields: [lessonId], references: [id])

  // Cloudinary Artifact/Image URL or Zip link
  artifactUrl String
  codeSnippet String?             @db.Text
  fileSizeKb  Float?              @default(4.2)
  versionTag  String              @default("v1.2 Final")
  status      CertificationStatus @default(PENDING)

  idempotencyKey String? @unique

  certification Certification?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId])
  @@index([lessonId])
  @@index([status])
}

model Certification {
  id           String     @id @default(uuid())
  submissionId String     @unique
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  mentorId     String
  mentor       User       @relation("MentorCertifications", fields: [mentorId], references: [id])

  scoreCompleted     Int @default(20)
  scoreQuality       Int @default(18)
  scoreRealProblem   Int @default(19)
  scorePresentation  Int @default(17)
  scoreParticipation Int @default(20)
  totalScore         Int @default(94)

  notes     String?             @db.Text
  status    CertificationStatus @default(APPROVED)
  createdAt DateTime            @default(now())

  @@index([mentorId])
}

// 5. STUDENT PORTFOLIO & ATTENDANCE

model Project {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String
  tag         String

  // Cloudinary Project Screenshot URL
  imageUrl String

  liveUrl   String?
  githubUrl String?

  isVerified Boolean @default(false)
  verifiedBy String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model TrackMeeting {
  id        String             @id @default(uuid())
  trackId   String
  track     Track              @relation(fields: [trackId], references: [id], onDelete: Cascade)
  type      MeetingType
  date      DateTime
  records   AttendanceRecord[]
  createdAt DateTime           @default(now())

  @@index([trackId])
}

model AttendanceRecord {
  id           String       @id @default(uuid())
  meetingId    String
  meeting      TrackMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  studentId    String
  student      User         @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Cascade)
  recordedById String
  recordedBy   User         @relation("SupporterAttendance", fields: [recordedById], references: [id])
  isPresent    Boolean      @default(false)
  createdAt    DateTime     @default(now())

  @@unique([meetingId, studentId])
  @@index([studentId])
  @@index([meetingId])
}
